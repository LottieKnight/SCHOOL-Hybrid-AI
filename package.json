{
  "name": "@saedu/design-tokens",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run env:check && npm run db:past-papers:generate",
    "dev": "npm run predev && concurrently -k -n web,api -c cyan,magenta \"npm run dev:web:raw\" \"npm run dev:api\"",
    "dev:mobile": "npm run start -w apps/mobile",
    "predev:web": "npm run predev",
    "dev:web": "npm run dev:web:raw",
    "dev:web:raw": "npm run dev -w apps/web -- --hostname 0.0.0.0 --port 3000",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "build:web": "npm run build -w packages/shared && npm run build -w apps/web",
    "build:api": "npm run build -w packages/shared && npm run build -w apps/api",
    "start": "npm run start -w apps/web",
    "start:web": "npm run start -w apps/web",
    "start:mobile": "npm run start -w apps/mobile",
    "start:api": "npm run start -w apps/api",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/api",
    "check:lesson-boundary": "node tools/enforce-lesson-boundary.mjs",
    "verify:route-ownership": "node tools/verify-route-ownership.mjs",
    "typecheck": "npm run check:lesson-boundary && npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "typecheck:mobile": "npm run typecheck -w apps/mobile",
    "load:test": "node --import tsx scripts/load-test.ts",
    "test": "npm run test -w packages/shared && npm run test -w apps/api",
    "env:check": "node tools/check-env.mjs",
    "db:migrate": "npm run migrate -w apps/api",
    "db:past-papers:generate": "node tools/prisma-generate-safe.mjs",
    "db:past-papers:migrate": "prisma migrate deploy --schema apps/web/prisma/schema.prisma",
    "db:past-papers:push": "prisma db push --schema apps/web/prisma/schema.prisma",
    "ingest:dbe": "tsx scripts/ingest-dbe-past-papers.ts",
    "seed:university-calendars": "tsx scripts/seed-university-calendars.ts",
    "ingest:dbe:smoke": "tsx scripts/ingest-dbe-smoke.ts",
    "ingest:dbe:smoke50": "tsx scripts/ingest-dbe-smoke.ts --max-links=50",
    "ingest:dbe:repair-smoke": "tsx scripts/ingest-dbe-smoke.ts --max-links=50 --repair-orphans --repair-limit=50",
    "test:dbe-fetch": "tsx scripts/test-dbe-fetch.ts",
    "test:sources": "tsx scripts/assert-sources.ts",
    "debug:past-papers": "tsx scripts/debug-past-papers.ts",
    "coverage:past-papers": "tsx scripts/past-papers-coverage.ts",
    "doctor:past-papers": "tsx scripts/doctor-past-papers.ts",
    "security:audit": "npm audit --audit-level=high",
    "security:sast:local": "npx --yes @semgrep/cli semgrep --config=auto apps packages scripts tools",
    "security:secrets:local": "gitleaks detect --no-git --config tools/security/gitleaks.toml --source . --redact",
    "security:trivy:local": "trivy fs --severity HIGH,CRITICAL --exit-code 1 .",
    "security:headers-check": "node tools/security/check-headers.mjs",
    "security:android-release": "node tools/security/check-android-release.mjs",
    "security:canonical-origin": "node tools/security/check-canonical-origin.mjs",
    "security:all": "npm run security:audit && npm run security:sast:local && npm run security:secrets:local && npm run security:trivy:local && npm run security:headers-check && npm run security:android-release && npm run security:canonical-origin && npm run verify:route-ownership",
    "backfill:past-papers:year": "tsx scripts/backfill-past-papers-year.ts",
    "ingest:dbe:gauteng": "tsx scripts/ingest-dbe-past-papers.ts --source=DBE --province=gauteng --repair-orphans --repair-limit=200 --no-fail-on-error",
    "warm:past-papers": "tsx scripts/warm-past-papers-routes.ts",
    "ingest:pdf-lessons": "npm run ingest:pdf-lessons -w packages/shared",
    "validate:lessons": "npm run validate:lessons -w packages/shared",
    "content:index": "npm run content:index -w packages/shared",
    "content:floor": "npm run content:floor -w packages/shared",
    "content:generated-outline": "npm run content:generated-outline -w packages/shared",
    "lessons:shells": "npm run lessons:shells -w packages/shared",
    "rag:index": "npm run rag:index -w packages/shared",
    "rag:generate": "npm run rag:generate -w packages/shared",
    "rag:v1:index": "npm run rag:v1:index -w packages/shared",
    "rag:v1:generate": "npm run rag:v1:generate -w packages/shared",
    "seed:caps": "npm run seed:caps -w packages/shared",
    "gen:lesson": "npm run gen:lesson -w packages/shared",
    "gen:term": "npm run gen:term -w packages/shared",
    "verify:release": "tsx scripts/release-verify/run.ts --suite=all",
    "verify:release:playwright": "tsx apps/web/e2e/prod/run.ts --all",
    "verify:release:playwright:journeys": "tsx apps/web/e2e/prod/run.ts journeys",
    "verify:release:playwright:a11y": "tsx apps/web/e2e/prod/run.ts a11y",
    "verify:release:playwright:perf": "tsx apps/web/e2e/prod/run.ts perf",
    "verify:release:playwright:visual": "tsx apps/web/e2e/prod/run.ts visual",
    "verify:typecheck": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --esModuleInterop --skipLibCheck --typeRoots node_modules/@types --types node scripts/release-verify/config.ts scripts/release-verify/result.ts scripts/release-verify/http.ts scripts/release-verify/run.ts scripts/release-verify/suites/*.ts apps/web/e2e/prod/config.ts apps/web/e2e/prod/harness.ts apps/web/e2e/prod/journeys.ts apps/web/e2e/prod/a11y.ts apps/web/e2e/prod/perf.ts apps/web/e2e/prod/visual.ts apps/web/e2e/prod/run.ts"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "openai": "^6.17.0",
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@react-native/gradle-plugin": "^0.81.5",
    "@types/react": "^19.1.0",
    "ajv": "^8.20.0",
    "concurrently": "^8.2.2",
    "next": "16.2.7",
    "prisma": "^5.22.0",
    "semgrep": "0.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18 <25",
    "npm": ">=9"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "version": "0.1.0",
  "main": "src/index.js",
  "types": "src/index.d.ts"
}
