{
  "name": "@saedu/api",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.14 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix ../../packages/shared run build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsx --test --test-force-exit test/run-all.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "messages:encrypt-backfill": "tsx src/scripts/encrypt-message-bodies.ts",
    "import:osm-schools": "tsx src/scripts/import-osm-schools.ts",
    "import:schools-csv": "tsx src/scripts/import-schools-csv.ts",
    "payouts:run": "tsx src/scripts/run-payouts.ts",
    "backfill:lesson-images": "tsx src/scripts/backfill-lesson-images.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@node-saml/node-saml": "^4.0.5",
    "@saedu/shared": "*",
    "@sentry/node": "^8.15.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "dotenv": "^16.4.5",
    "expo-device": "~8.0.10",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "next": "16.2.11",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "resend": "^6.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "eslint": "^9.9.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.7.0"
  }
}
