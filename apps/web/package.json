{
  "name": "@saedu/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18 <25"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "next dev",
    "prebuild": "npm run prisma:generate",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build --webpack && node scripts/ensure-next-lock.mjs",
    "build:web": "npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "embed:curriculum": "tsx scripts/generate-embeddings.ts",
    "seed:institutions": "tsx scripts/seed-institutions.ts",
    "screenshots:matrix": "node scripts/device-matrix.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fastify/jwt": "10.0.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/client": "^5.22.0",
    "@saedu/shared": "*",
    "@sentry/nextjs": "^10.53.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.18.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.8.5",
    "firebase": "13.4.0",
    "framer-motion": "^12.9.4",
    "ioredis": "^5.9.2",
    "jose": "^6.2.3",
    "katex": "^0.16.47",
    "mammoth": "^1.11.0",
    "marked": "^12.0.2",
    "mermaid": "^11.17.2",
    "next": "^16.3.3",
    "next-intl": "^4.13.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.7.76",
    "pg": "^8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.1.0",
    "react-pdf": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.13.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/eslintrc": "^3.1.0",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-onboarding": "^10.2.0",
    "@storybook/addon-vitest": "^10.2.0",
    "@storybook/nextjs-vite": "^10.2.0",
    "@types/node": "^20.12.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "critters": "^0.0.23",
    "eslint": "^9.9.0",
    "eslint-config-next": "^16.2.6",
    "openai": "^6.39.1",
    "playwright": "^1.57.0",
    "storybook": "^10.2.0",
    "typescript": "^5.5.4",
