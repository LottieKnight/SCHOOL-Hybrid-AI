NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LITE_MODE_DEFAULT=false
COURSE_OUTLINE_PATH=../packages/shared/content/course_outline.json
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
AT_API_KEY=
AT_USERNAME=sandbox
LESSON_CONTENT_PATH=../packages/shared/content/lessons
ADMIN_EMAILS=comma-separated list of admin emails
# Past-papers ingest guard (bearer/x-admin-ingest-token). Must match the GitHub
# Actions ADMIN_INGEST_TOKEN secret that POSTs to /api/admin/ingest/past-papers.
# See docs/engineering/INGEST_SECRETS.md.
ADMIN_INGEST_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
DATABASE_URL=postgres://saedu:saedu_password@localhost:5433/saedu
PAST_PAPERS_DATABASE_URL=file:./past-papers.db
PAST_PAPERS_STORAGE=local
PAST_PAPERS_STORAGE_ROOT=
PAST_PAPERS_DETAILED_REPORT_CREDITS=15
WALLET_DETAILED_REPORT_CREDITS=15
EQUIPMENT_QUOTE_RETENTION_DAYS=30
ALLOW_DEMO_AUTH=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Hybrid tutor (Firebase AI Logic). Leave blank to keep the page usable without keys.
# Never commit real values. See docs/HACKATHON.md.
# Auth, Google Sign-In, App Check, Remote Config, and Firestore use this project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Local debug token only. Do not set this in production.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
# Optional second Firebase project for Hybrid Tutor AI Logic only.
# When these are empty, Gemini uses NEXT_PUBLIC_FIREBASE_* above.
# Do not copy the primary reCAPTCHA site key here.
NEXT_PUBLIC_FIREBASE_AI_API_KEY=
NEXT_PUBLIC_FIREBASE_AI_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_AI_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AI_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_AI_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_AI_APP_ID=
# Only if the AI project has its own App Check reCAPTCHA Enterprise site key.
NEXT_PUBLIC_FIREBASE_AI_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_AI_APP_CHECK_DEBUG_TOKEN=
