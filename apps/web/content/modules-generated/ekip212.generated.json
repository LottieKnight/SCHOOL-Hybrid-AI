          "id": "chapter-2-quota-imports-example",
          "chapter": "Chapter 2",
          "title": "Compute imports under a quota-style trade diagram",
          "summary": "The quota reference solves Ecuador's free-trade quantities at a world price of $300.",
          "problem": "At a price of $300, Ecuador produces 15 computers and demands 85 computers. How many computers must be imported?",
          "steps": [
            {
              "label": "Identify domestic production",
              "explanation": "The source states Ecuador produces 15 computers at the world price."
            },
            {
              "label": "Identify domestic demand",
              "explanation": "The source states Ecuador demands 85 computers at the same price."
            },
            {
              "label": "Compute imports",
              "explanation": "Imports = demand - domestic production = 85 - 15 = 70."
            }
          ],
          "answer": "Ecuador imports 70 computers.",
