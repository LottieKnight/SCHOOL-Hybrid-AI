          "id": "chapter-2-effective-protection-example",
          "chapter": "Chapter 2",
          "title": "Calculate the effective rate of protection",
          "summary": "The protection reference uses steel worth $1,000,000, imported taconite worth $100,000, and tariffs of 20% and 10%.",
          "problem": "Given n = 0.2, a = 0.1, and b = 0.1, calculate the effective rate of protection.",
          "formula": "e = (n - ab) / (1 - a)",
          "steps": [
            {
              "label": "Compute the input share",
              "explanation": "a = 100,000 / 1,000,000 = 0.1."
            },
            {
              "label": "Substitute the tariff values",
              "explanation": "e = (0.2 - (0.1 x 0.1)) / (1 - 0.1) = (0.2 - 0.01) / 0.9."
            },
            {
              "label": "Finish the calculation",
              "explanation": "0.19 / 0.9 = 0.21, which is 21%."
            }
          ],
          "answer": "The effective rate of protection is 21%.",
