# Environment for the release verification runner + Playwright harness.
# Copy to <repo>/.env.verify and fill with real, disposable test values.
# This file is gitignored — never commit real credentials.

# Required — the live production origin to verify
BASE_URL=https://school.ditshego-ventures.co.za

# Optional — off-origin backend probe (defaults to same-origin proxy)
# API_BASE_URL=http://localhost:8000

# Test identities (never printed by the runner)
TEST_USER_EMAIL=student@example.com
TEST_USER_PASSWORD=replace-me
# ADMIN_TEST_USER_EMAIL=
# ADMIN_TEST_USER_PASSWORD=
# PAID_TEST_USER_EMAIL=
# PAID_TEST_USER_PASSWORD=

# Known content keys for paid-content / attempt suites
# PAST_PAPER_ID=some-slug
# PAST_PAPER_ATTEMPT_ID=ck-unique-attempt-id
# PAST_PAPER_OWNER_EMAIL=
# PAST_PAPER_OWNER_PASSWORD=

# Optional feature toggles
# VERIFY_AI_ANON_DAILY=1        # ~65s probe that verifies the 5/day limit
# VERIFY_AUTH_AI_LIMITS=1       # probes authenticated limits (uses quota)

# Optional direct Redis probe (value never printed)
# REDIS_VERIFY_URL=rediss://...

# Optional metrics token (only if a metrics endpoint is confirmed to exist)
# METRICS_TOKEN=

# Output location (default artifacts/release-verify)
# VERIFY_OUTPUT_DIR=artifacts/release-verify

# Allow self-signed TLS (staging only — do not use in production)
# ALLOW_INSECURE=1

# Playwright knobs
# PW_HEADED=1
# PW_SLOW_MO=100
# PW_TIMEOUT_MS=45000
# PW_CONCURRENT=1               # also enables throttled-mobile perf profile
# PW_A11Y_GATE=serious          # critical|serious|moderate|off
# PW_OUTPUT_DIR=artifacts/release-verify/playwright

# Registration test (creates a disposable account — use only on a disposable domain)
# ENABLE_REGISTER_TEST=1
# REGISTER_DISPOSABLE_EMAIL=new.student@example.com