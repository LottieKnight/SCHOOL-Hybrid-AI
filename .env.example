# Root-level variables (used by docker-compose and local dev)
POSTGRES_USER=saedu
POSTGRES_PASSWORD=saedu_password
POSTGRES_DB=saedu
POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3002,http://localhost:3001,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Local connection strings for the API
DATABASE_URL=postgres://saedu:saedu_password@localhost:5433/saedu
REDIS_URL=redis://localhost:6379

# Secrets
JWT_SECRET=change_me
COOKIE_SECRET=change_me
ADMIN_EMAILS=comma-separated list of admin emails
OPENAI_API_KEY=

# Embeddings / RAG — Phase 7 Voyage migration (see docs/superpowers/specs/2026-05-31-architectural-upgrades.md §1)
# Set VOYAGE_API_KEY to route embedQuery() through Voyage (voyage-3-lite -> 512 dims).
# Leave it unset to keep the local EMBEDDING_SERVER_URL fallback (1536-dim) until the
# Supabase `documents.embedding` column is re-embroidered to 512 dims.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
# Supabase hosts the RAG `documents` table + match_documents RPC (needed for the vector(512) reindex)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMBEDDING_SERVER_URL=http://localhost:8001

# Transactional email (Resend — https://resend.com, free tier: 3000/month)
# Set RESEND_API_KEY to enable email notifications. Without it, notifications are in-app only.
RESEND_API_KEY=
EMAIL_FROM=SCHOOL <notifications@school.ditshego-ventures.co.za>
NEXT_PUBLIC_SITE_URL=https://school.ditshego-ventures.co.za

# SMS / Phone OTP (Twilio — https://twilio.com)
# Set all three to enable real SMS-based phone verification.
# Without them, phone verification returns 501 (or uses the fake OTP in dev if ALLOW_FAKE_PHONE_VERIFY=true).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Optional overrides
COURSE_OUTLINE_PATH=packages/shared/content/course_outline.json
LESSON_CONTENT_PATH=content/lessons
LESSON_JSON_ROOT=content/lessons
LESSON_PDF_ROOT=content/pdf
LOG_LEVEL=info
METRICS_TOKEN=
MIN_SESSION_PRICE=120
COMMISSION_RATE=0.12
ZERO_RATED_ENDPOINTS=/api/lesson-json,/api/lessons/quiz/bias,/api/lessons/quiz/attempt
CANCELLATION_WINDOW_HOURS=6
DISPUTE_WINDOW_HOURS=48
NO_SHOW_GRACE_MINUTES=15
CANCELLATION_FEE_PERCENT=0.3
NO_SHOW_PAYOUT_PERCENT=0.5
SESSION_REQUEST_LIMIT_PER_HOUR=4
SESSION_REQUEST_LIMIT_PER_DAY=10
DISPUTE_LIMIT_PER_DAY=3
ASSIGNMENT_REMINDER_POLL_SECONDS=60
ASSIGNMENT_REMINDER_BATCH_SIZE=300
ALLOW_FAKE_PHONE_VERIFY=false
ALLOW_DEMO_AUTH=false
WALLET_CREDITS_PER_ZAR=100
WALLET_DETAILED_REPORT_CREDITS=15
EQUIPMENT_QUOTE_RETENTION_DAYS=30

# Past Papers (apps/web)
PAST_PAPERS_DATABASE_URL=file:./past-papers.db
PAST_PAPERS_STORAGE=local
PAST_PAPERS_STORAGE_ROOT=
PAST_PAPERS_DEMO_USER_ID=demo-user
PAST_PAPERS_DETAILED_REPORT_CREDITS=15
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# BrandOS — Platform API Keys (optional; publishers are TODO stubs until implemented)
# X (Twitter) API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# LinkedIn
LINKEDIN_ACCESS_TOKEN=
# Instagram Graph API
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# BrandOS config
BRAND_OS_ENABLED=true
BRAND_WEEKLY_POST_TARGET=12
# API worker must run for BrandOS queue (set ENABLE_WORKER=true when running workers)
ENABLE_WORKER=false
